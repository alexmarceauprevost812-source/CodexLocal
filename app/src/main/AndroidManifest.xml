<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fournisseurs distants + telechargement des modeles et des mises a jour -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Installation des mises a jour de l'appli -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Partage des modeles .gguf dans un dossier public commun (avec LexOS, etc.) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Retirer une appli fabriquee par le Studio (par exemple apres un changement de cle) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Ti-Labo : moteur en arriere-plan pour Termux, rappels de l'agenda, meteo, demarrage du Ti-Labo complet -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Voir (et ouvrir) les applis fabriquees par le Studio, qui ont un icone de lanceur -->
    <queries>
        <package android:name="com.termux" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CodexLocal">

        <!--
          configChanges : l'activite n'est plus detruite quand on pivote l'ecran.
          La conversation en cours reste donc intacte en mode paysage.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PartageActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="false"
            android:label="@string/bureau_partager"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <!-- Editeur de code, ouvert depuis le menu lateral quand un projet est choisi -->
        <activity
            android:name=".editor.CodeEditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="false"
            android:label="@string/editor_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- Studio : projets, dossiers, IA qui cree des fichiers, images SVG -->
        <activity
            android:name=".studio.StudioActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:label="@string/studio_titre"
            android:windowSoftInputMode="adjustResize">
            <!-- Ouvert directement sur « Signature » depuis LexOS (bouton Signer un APK du Labo) -->
            <intent-filter>
                <action android:name="com.codexlocal.action.SIGNER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Bureau : toutes les entrees de menu en icones, comme l'ecran d'accueil d'un telephone -->
        <activity
            android:name=".bureau.BureauActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="false"
            android:label="@string/bureau_titre" />

        <!-- Vue « projet » facon GitHub : dossiers, fichiers, favori, ajout, modification -->
        <activity
            android:name=".projet.ProjetActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="false"
            android:label="@string/studio_titre" />

        <!-- Ti-Labo : Bureau, Jasette, Codex, Agenda, Cle USB-C, GitHub (meme moteur que CodexLocal) -->
        <activity
            android:name=".tilabo.TiLaboActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale"
            android:exported="false"
            android:label="Ti-Labo"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".tilabo.TiLaboService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Moteur d'IA local (llama.cpp) qui repond au Ti-Labo sur 127.0.0.1" />
        </service>

        <receiver android:name=".tilabo.RappelRecepteur" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Permet de passer l'APK telecharge au gestionnaire de paquets Android -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
