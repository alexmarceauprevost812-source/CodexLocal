<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================= MOTEUR ================= -->
        <TextView
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_engine"
            android:textColor="@color/orange" />

        <RadioGroup
            android:id="@+id/rgProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/orange"
                android:text="@string/provider_local"
                android:textColor="@color/white" />

            <RadioButton
                android:id="@+id/rbOpenai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/orange"
                android:text="@string/provider_openai"
                android:textColor="@color/white" />

            <RadioButton
                android:id="@+id/rbAnthropic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/orange"
                android:text="@string/provider_anthropic"
                android:textColor="@color/white" />

            <RadioButton
                android:id="@+id/rbGemini"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/orange"
                android:text="@string/provider_gemini"
                android:textColor="@color/white" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/divider" />

        <!-- ================= LOCAL ================= -->
        <TextView
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_local"
            android:textColor="@color/orange" />

        <TextView
            android:id="@+id/tvLocalStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/status_init"
            android:textColor="@color/white"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLocalDir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/local_dir_hint"
            android:textColor="@color/grey"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spModels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/orange"
            android:popupBackground="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRefresh"
                style="@style/OrangeTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_refresh" />

            <Button
                android:id="@+id/btnLoad"
                style="@style/OrangeTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_load" />

            <Button
                android:id="@+id/btnUnload"
                style="@style/OrangeTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_unload" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_choose_model"
            android:textColor="@color/white" />

        <Spinner
            android:id="@+id/spCatalog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/orange"
            android:popupBackground="@color/black" />

        <EditText
            android:id="@+id/etDownloadUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/orange"
            android:hint="@string/hint_download_url"
            android:inputType="textUri"
            android:textColor="@color/white"
            android:textColorHint="@color/grey_dark"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDownload"
                style="@style/OrangeTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_download" />

            <Button
                android:id="@+id/btnImport"
                style="@style/OrangeTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_import" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/divider" />

        <!-- ================= DISTANT ================= -->
        <TextView
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_remote"
            android:textColor="@color/orange" />

        <EditText
            android:id="@+id/etBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/orange"
            android:hint="@string/hint_base_url"
            android:inputType="textUri"
            android:textColor="@color/white"
            android:textColorHint="@color/grey_dark"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/orange"
            android:hint="@string/hint_model"
            android:inputType="text"
            android:textColor="@color/white"
            android:textColorHint="@color/grey_dark"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/orange"
            android:hint="@string/hint_api_key"
            android:inputType="textPassword"
            android:textColor="@color/white"
            android:textColorHint="@color/grey_dark"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/divider" />

        <!-- ================= COMMUN ================= -->
        <TextView
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_common"
            android:textColor="@color/orange" />

        <TextView
            android:id="@+id/tvTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_temperature"
            android:textColor="@color/white" />

        <SeekBar
            android:id="@+id/sbTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="3"
            android:progressTint="@color/orange"
            android:thumbTint="@color/orange" />

        <EditText
            android:id="@+id/etMaxTokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/orange"
            android:hint="@string/hint_max_tokens"
            android:inputType="number"
            android:textColor="@color/white"
            android:textColorHint="@color/grey_dark"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/label_system_prompt"
            android:textColor="@color/white" />

        <EditText
            android:id="@+id/etSystemPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/orange"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:textColor="@color/white"
            android:textColorHint="@color/grey_dark"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swAutoUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/auto_update"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnCheckUpdate"
            style="@style/OrangeTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_update_now" />

        <Button
            android:id="@+id/btnInstallApk"
            style="@style/OrangeTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_install_apk" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancel"
                style="@style/OrangeTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_cancel" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/btn_save"
                android:textColor="@color/black" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
