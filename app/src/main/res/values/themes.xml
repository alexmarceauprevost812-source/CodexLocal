<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Theme unique, force en sombre : noir pur partout, accents orange.
      Base "Dark" (et non "DayNight") pour que le noir reste noir meme si le
      telephone est en mode clair.
    -->
    <style name="Base.Theme.CodexLocal" parent="Theme.Material3.Dark.NoActionBar">

        <!-- Orange = couleur principale -->
        <item name="colorPrimary">@color/orange</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/orange</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/orange</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/orange_dark</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="colorTertiary">@color/orange_bright</item>
        <item name="colorOnTertiary">@color/black</item>

        <!-- Noir AMOLED -->
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/grey</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <!-- Fenetre / barres systeme -->
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Textes -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/grey</item>
        <item name="android:textColorHint">@color/grey_dark</item>

        <!-- Curseurs, cases, soulignements : orange -->
        <item name="colorControlNormal">@color/orange</item>
        <item name="colorControlActivated">@color/orange</item>
        <item name="colorControlHighlight">@color/orange_translucent</item>
        <item name="android:colorControlActivated">@color/orange</item>
        <item name="android:colorAccent">@color/orange</item>
    </style>

    <style name="Theme.CodexLocal" parent="Base.Theme.CodexLocal" />

    <!-- Bouton texte orange, reutilisable partout -->
    <style name="OrangeTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/orange</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="rippleColor">@color/orange_translucent</item>
    </style>

</resources>
